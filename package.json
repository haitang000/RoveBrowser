{
  "name": "rove",
  "version": "0.1.0-beta2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "native:dev": "npm run build && cargo run --manifest-path native/Cargo.toml",
    "native:build": "npm run build && cargo build --release --manifest-path native/Cargo.toml",
    "test:e2e": "playwright test",
    "test:native": "node scripts/native-smoke.mjs",
    "test:native:favorites": "node scripts/native-favorites-smoke.mjs",
    "test:native:command": "node scripts/native-command-smoke.mjs",
    "test:native:spaces": "node scripts/native-spaces-smoke.mjs",
    "test:native:preview": "node scripts/native-tab-preview-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "vue-tsc": "^3.1.4"
  }
}
